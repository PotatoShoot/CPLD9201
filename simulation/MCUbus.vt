`timescale 1ns / 1ps

module Top_vlg_tst;

    // Inputs
    reg clk;
    reg rst_n;
    reg [7:0] DB;
    reg ALE;
    reg WR;
    reg RD;
    reg [15:0] ad_data;
    reg ad_busy;
    reg ad_first_data;
    reg [2:0] ad_os;
    reg ad_cs;
    reg ad_rd;
    reg ad_reset;
    reg ad_convstb;
    reg ad_convsta;
    reg ad_stby;
    reg ad_range;

    // Outputs
    wire [7:0] sine_out;
    wire [15:0] tad_ch1;
    wire [15:0] tad_ch2;
    wire [15:0] tad_ch3;
    wire [15:0] tad_ch4;
    wire [15:0] tad_ch5;
    wire [15:0] tad_ch6;
    wire [15:0] tad_ch7;
    wire [15:0] tad_ch8;

    // Instantiate the Unit Under Test (UUT)
    Top uut (
        .clk(clk),
        .rst_n(rst_n),
        .DB(DB),
        .ALE(ALE),
        .WR(WR),
        .RD(RD),
        .sine_out(sine_out),
        .ad_data(ad_data),
        .ad_busy(ad_busy),
        .ad_first_data(ad_first_data),
        .ad_os(ad_os),
        .ad_cs(ad_cs),
        .ad_rd(ad_rd),
        .ad_reset(ad_reset),
        .ad_convstb(ad_convstb),
        .ad_convsta(ad_convsta),
        .ad_stby(ad_stby),
        .ad_range(ad_range)
    );

    // Clock generation
    initial begin
        clk = 0;
        forever #5 clk = ~clk;  // 100 MHz clock
    end

    // Test sequence
    initial begin
        // Initialize Inputs
        rst_n = 0;
        DB = 8'b0;
        ALE = 1;
        WR = 1;
        RD = 1;
        ad_data = 16'b0;
        ad_busy = 0;
        ad_first_data = 0;
        ad_os = 3'b0;
        ad_cs = 1;
        ad_rd = 1;
        ad_reset = 1;
        ad_convstb = 1;
        ad_convsta = 0;
        ad_stby = 0;
        ad_range = 0;

        // Wait 100 ns for global reset to finish
        #100;

        // Apply test vectors
        rst_n = 1;  // Deassert reset

        // Test case 1: Write to MCUbus
        ALE = 0;
        WR = 0;
        DB = 8'b10101010;
        #10;
        WR = 1;
        ALE = 1;

        // Test case 2: Read from MCUbus
        ALE = 0;
        RD = 0;
        #10;
        RD = 1;
        ALE = 1;

        // Test case 3: Simulate AD7606 data
        ad_data = 16'b1100110011001100;
        ad_busy = 1;
        ad_first_data = 1;
        #10;
        ad_busy = 0;
        ad_first_data = 0;

        // Test case 4: Change AD7606 oversampling rate
        ad_os = 3'b1;
        #10;

        // Test case 5: Simulate AD7606 control signals
        ad_reset = 0;
        ad_convstb = 0;
        #10;
        ad_reset = 1;
        ad_convstb = 1;

        // Add more test cases as needed

        // End simulation
        #1000 $finish;
    end

endmodule